// fs.kc -- KCFS: the in-memory hierarchical filesystem (directories and files stored on the kernel heap).
// Author: Divyanshu Sinha (MIT License)
//
// KCFS 2: every node has a name, a parent, wall-clock created / modified times (seconds since 1970, from the RTC) and
// attributes (read-only, hidden, system).  Mutations mark the tree dirty; kcfs.kc saves it crash-safely (two alternating
// slots, CRC32, generation counter) -- automatically a few seconds after the last change and on shutdown.
// Besides create/write/remove there are rename, move, recursive copy, sorted listings, usage totals and fsck.
const FS_MAX = 2048;
const FS_NAME = 28;
const K_FREE = 0;
const K_FILE = 1;
const K_DIR = 2;
const FA_RO = 1;                    // read-only: cannot be written, renamed, moved or deleted
const FA_HIDDEN = 2;                // hidden from the Files app unless "show hidden" is on
const FA_EXEC = 8;                  // executable program (Peacock .pea binaries; shown with an x)
const FA_SYS = 4;                   // system file (listed with an S flag; informational)

struct FsNode {
    name: u8[28],
    kind: int,
    parent: int,
    size: int,
    cap: int,
    data: *u8,
    mtime: int,                     // last modification, seconds since 1970-01-01 (0 = unknown)
    ctime: int,                     // creation time
    attr: int                       // FA_* flags
}

var fs_nodes: *FsNode;              // FS_MAX nodes, allocated on the kernel heap by fs_init
var fs_cwd = 0;
var fs_dirty = false;               // changed since the last successful save
var fs_dirty_t = 0;                 // tick of the first change after the last save

var fs_rev = 0;                     // bumped on every change (views use it to refresh)
fn fs_mark() { fs_rev++; if (!fs_dirty) { fs_dirty = true; fs_dirty_t = ticks; } }

// ---------------------------------------------------------------- wall-clock time
/// days since 1970-01-01 of a civil date (proleptic Gregorian)
fn fs_days(y0: int, m: int, d: int) -> int {
    var y = y0;
    if (m <= 2) { y = y - 1; }
    var era = y / 400;
    if (y < 0) { era = (y - 399) / 400; }
    let yoe = y - era * 400;
    var mp = m + 9;
    if (m > 2) { mp = m - 3; }
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}
fn fs_now() -> int {
    var t: int[6];
    rtc_read(&t[0]);
    return fs_days(t[0], t[1], t[2]) * 86400 + t[3] * 3600 + t[4] * 60 + t[5];
}
/// civil date of a day count: out[0]=year out[1]=month out[2]=day
fn fs_civil(days: int, out: *int) {
    let z = days + 719468;
    var era = z / 146097;
    if (z < 0) { era = (z - 146096) / 146097; }
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    var m = mp + 3;
    if (mp >= 10) { m = mp - 9; }
    out[0] = y; out[1] = m; out[2] = d;
    if (m <= 2) { out[0] = y + 1; }
}
/// "2026-11-10 14:07" (or "-" when the time is unknown) into out (at least 20 bytes)
fn fs_time_str(t: int, out: *u8) {
    if (t <= 0) { out[0] = '-'; out[1] = 0; return; }
    var c: int[3];
    fs_civil(t / 86400, &c[0]);
    let sod = t % 86400;
    out[0] = ('0' + (c[0] / 1000) % 10) as u8; out[1] = ('0' + (c[0] / 100) % 10) as u8; out[2] = ('0' + (c[0] / 10) % 10) as u8; out[3] = ('0' + c[0] % 10) as u8;
    out[4] = '-'; out[5] = ('0' + c[1] / 10) as u8; out[6] = ('0' + c[1] % 10) as u8;
    out[7] = '-'; out[8] = ('0' + c[2] / 10) as u8; out[9] = ('0' + c[2] % 10) as u8;
    out[10] = ' ';
    out[11] = ('0' + sod / 36000) as u8; out[12] = ('0' + (sod / 3600) % 10) as u8; out[13] = ':';
    out[14] = ('0' + (sod / 60) % 60 / 10) as u8; out[15] = ('0' + (sod / 60) % 10) as u8; out[16] = 0;
}

fn fs_init() {
    if (fs_nodes == (0 as *FsNode)) { fs_nodes = kzalloc(FS_MAX * sizeof(FsNode)) as *FsNode; }
    if (fs_nodes == (0 as *FsNode)) { return; }
    var i = 0;
    while (i < FS_MAX) { fs_nodes[i].kind = K_FREE; i++; }
    fs_nodes[0].kind = K_DIR;
    fs_nodes[0].parent = 0;
    fs_nodes[0].name[0] = 0;
    fs_nodes[0].mtime = 0; fs_nodes[0].ctime = 0; fs_nodes[0].attr = 0;
    fs_cwd = 0;
    fs_dirty = false;
}

fn fs_child(dir: int, name: *u8) -> int {
    var i = 0;
    while (i < FS_MAX) {
        if (fs_nodes[i].kind != K_FREE && i != 0 && fs_nodes[i].parent == dir && kstreq(&fs_nodes[i].name[0], name)) { return i; }
        i++;
    }
    return -1;
}

/// resolve a path (absolute or relative to the working directory); -1 when it does not exist
fn fs_resolve(path: *u8) -> int {
    var cur = fs_cwd;
    var i = 0;
    if (path[0] == '/') { cur = 0; i = 1; }
    var comp: u8[32];
    while (path[i] != 0) {
        if (path[i] == '/') { i++; continue; }
        var n = 0;
        while (path[i] != 0 && path[i] != '/') {
            if (n >= FS_NAME - 1) { return -1; }
            comp[n] = path[i]; n++; i++;
        }
        comp[n] = 0;
        if (kstreq(&comp[0], ".")) { continue; }
        if (kstreq(&comp[0], "..")) { cur = fs_nodes[cur].parent; continue; }
        if (fs_nodes[cur].kind != K_DIR) { return -1; }
        let c = fs_child(cur, &comp[0]);
        if (c < 0) { return -1; }
        cur = c;
    }
    return cur;
}

/// split "a/b/c" into the directory node of "a/b" and the final name "c" (copied into `name`); -1 on error
fn fs_split(path: *u8, name: *u8) -> int {
    var tmp: u8[128];
    kstrncpy(&tmp[0], path, 128);
    var n = kstrlen(&tmp[0]);
    while (n > 1 && tmp[n - 1] == '/') { n--; tmp[n] = 0; }
    var slash = -1;
    var i = 0;
    while (i < n) { if (tmp[i] == '/') { slash = i; } i++; }
    if (n == 0 || (slash == n - 1)) { return -1; }
    var dir = fs_cwd;
    var base = 0;
    if (slash == 0) { dir = 0; base = 1; }
    else if (slash > 0) { tmp[slash] = 0; dir = fs_resolve(&tmp[0]); base = slash + 1; }
    if (dir < 0 || fs_nodes[dir].kind != K_DIR) { return -1; }
    if (kstrlen(&tmp[base]) >= FS_NAME) { return -1; }
    kstrncpy(name, &tmp[base], FS_NAME);
    return dir;
}

fn fs_alloc_node() -> int {
    var i = 1;
    while (i < FS_MAX) { if (fs_nodes[i].kind == K_FREE) { return i; } i++; }
    return -1;
}

/// create a file or directory; returns the node, or -1 (exists / no space / bad path)
fn fs_create(path: *u8, kind: int) -> int {
    var name: u8[32];
    let dir = fs_split(path, &name[0]);
    if (dir < 0) { return -1; }
    if (kstreq(&name[0], ".") || kstreq(&name[0], "..")) { return -1; }
    if (fs_child(dir, &name[0]) >= 0) { return -1; }
    let n = fs_alloc_node();
    if (n < 0) { return -1; }
    kstrncpy(&fs_nodes[n].name[0], &name[0], FS_NAME);
    fs_nodes[n].kind = kind;
    fs_nodes[n].parent = dir;
    fs_nodes[n].size = 0;
    fs_nodes[n].cap = 0;
    fs_nodes[n].data = 0 as *u8;
    let now = fs_now();
    fs_nodes[n].mtime = now; fs_nodes[n].ctime = now; fs_nodes[n].attr = 0;
    fs_mark();
    return n;
}

fn fs_write(n: int, data: *u8, len: int, append: bool) -> bool {
    if (fs_nodes[n].kind != K_FILE) { return false; }
    if ((fs_nodes[n].attr & FA_RO) != 0) { return false; }
    if (!append) { fs_nodes[n].size = 0; fs_nodes[n].mtime = fs_now(); fs_mark(); }
    if (len <= 0) { return true; }
    let need = fs_nodes[n].size + len;
    if (need + 1 > fs_nodes[n].cap) {                       // keep room for the terminating NUL
        var cap = fs_nodes[n].cap * 2;
        if (cap < need + 1) { cap = need + 1; }
        if (cap < 64) { cap = 64; }
        let nd = kmalloc(cap);
        if (nd == (0 as *u8)) { return false; }
        if (fs_nodes[n].size > 0) { kmemcpy(nd, fs_nodes[n].data, fs_nodes[n].size); }
        kfree(fs_nodes[n].data);
        fs_nodes[n].data = nd;
        fs_nodes[n].cap = cap;
    }
    kmemcpy(fs_nodes[n].data + fs_nodes[n].size, data, len);
    fs_nodes[n].size = need;
    fs_nodes[n].data[need] = 0;
    fs_nodes[n].mtime = fs_now();
    fs_mark();
    return true;
}

fn fs_nonempty_dir(n: int) -> bool {
    var i = 1;
    while (i < FS_MAX) { if (fs_nodes[i].kind != K_FREE && fs_nodes[i].parent == n) { return true; } i++; }
    return false;
}

fn fs_remove(n: int) -> bool {
    if (n <= 0) { return false; }
    if ((fs_nodes[n].attr & FA_RO) != 0) { return false; }
    if (fs_nodes[n].kind == K_DIR && fs_nonempty_dir(n)) { return false; }
    if (fs_nodes[n].kind == K_FILE) { kfree(fs_nodes[n].data); }
    fs_nodes[n].kind = K_FREE;
    fs_nodes[n].data = 0 as *u8;
    fs_mark();
    return true;
}

/// absolute path of a node into `out` (at least 128 bytes)
fn fs_path(n: int, out: *u8) {
    if (n == 0) { out[0] = '/'; out[1] = 0; return; }
    var parts: int[16];
    var depth = 0;
    var cur = n;
    while (cur != 0 && depth < 16) { parts[depth] = cur; depth++; cur = fs_nodes[cur].parent; }
    var o = 0;
    while (depth > 0) {
        depth--;
        out[o] = '/'; o++;
        let nm = &fs_nodes[parts[depth]].name[0];
        var j = 0;
        while (nm[j] != 0 && o < 126) { out[o] = nm[j]; o++; j++; }
    }
    out[o] = 0;
}

/// out[0]=nodes used, out[1]=files, out[2]=dirs, out[3]=bytes stored
fn fs_stats(out: *int) {
    out[0] = 0; out[1] = 0; out[2] = 0; out[3] = 0;
    var i = 0;
    while (i < FS_MAX) {
        if (fs_nodes[i].kind != K_FREE) {
            out[0]++;
            if (fs_nodes[i].kind == K_FILE) { out[1]++; out[3] = out[3] + fs_nodes[i].size; } else { out[2]++; }
        }
        i++;
    }
}

fn fs_put_file(path: *u8, text: *u8) {
    let n = fs_create(path, K_FILE);
    if (n >= 0) { fs_write(n, text, kstrlen(text), false); }
}

fn fs_seed() {
    fs_create("/etc", K_DIR);
    fs_create("/home", K_DIR);
    fs_create("/docs", K_DIR);
    fs_create("/tmp", K_DIR);
    fs_put_file("/etc/hostname", "peacock\n");
    fs_put_file("/etc/motd", "Welcome to Peacock.\nType 'help' for the list of commands.\n");
    fs_put_file("/etc/os-release", "NAME=Peacock\nVERSION=1.0\nLANGUAGE=KingCobra\nCOMPILER=kcc --target kcos\n");
    fs_put_file("/home/hello.txt", "Hello from a file stored on the Peacock kernel heap.\n");
    fs_put_file("/docs/about.txt", "Peacock is written in KingCobra by Divyanshu Sinha.\nThe kernel is compiled by kcc; the boot stage is a KingCobra program.\n");
}

// ---------------------------------------------------------------- tree helpers (used by the shell and the installer)
/// true when node a is b or one of b's ancestors
fn fs_is_ancestor(a: int, b: int) -> bool {
    var c = b;
    var guard = 0;
    while (guard < 64) {
        if (c == a) { return true; }
        if (c == 0) { return false; }
        c = fs_nodes[c].parent;
        guard++;
    }
    return false;
}

/// true when n or anything below it is read-only
fn fs_tree_has_ro(n: int) -> bool {
    if ((fs_nodes[n].attr & FA_RO) != 0) { return true; }
    if (fs_nodes[n].kind == K_DIR) {
        var i = 1;
        while (i < FS_MAX) {
            if (fs_nodes[i].kind != K_FREE && fs_nodes[i].parent == n && i != n && fs_tree_has_ro(i)) { return true; }
            i++;
        }
    }
    return false;
}

/// remove a node and everything below it (refused as a whole when anything in it is read-only)
fn fs_remove_tree(n: int) -> bool {
    if (n <= 0) { return false; }
    if (fs_tree_has_ro(n)) { return false; }
    return fs_remove_tree2(n);
}
fn fs_remove_tree2(n: int) -> bool {
    if (n <= 0) { return false; }
    if (fs_nodes[n].kind == K_DIR) {
        var i = 1;
        while (i < FS_MAX) {
            if (fs_nodes[i].kind != K_FREE && fs_nodes[i].parent == n) { fs_remove_tree2(i); }
            i++;
        }
    }
    return fs_remove(n);
}

/// create every missing directory of an absolute path; returns the final node or -1
fn fs_mkdirs(path: *u8) -> int {
    var cur: u8[128];
    var o = 0;
    var i = 0;
    var node = 0;
    while (path[i] != 0 && o < 120) {
        if (path[i] == '/') {
            if (o > 0) { cur[o] = 0; node = fs_resolve(&cur[0]); if (node < 0) { node = fs_create(&cur[0], K_DIR); if (node < 0) { return -1; } } }
            cur[o] = '/'; o++; i++;
        } else { cur[o] = path[i]; o++; i++; }
    }
    cur[o] = 0;
    if (o == 0) { return 0; }
    node = fs_resolve(&cur[0]);
    if (node < 0) { node = fs_create(&cur[0], K_DIR); }
    return node;
}

// ---------------------------------------------------------------- KCFS 2 operations
fn fs_valid_name(name: *u8) -> bool {
    let n = kstrlen(name);
    if (n == 0 || n >= FS_NAME) { return false; }
    if (kstreq(name, ".") || kstreq(name, "..")) { return false; }
    var i = 0;
    while (i < n) { if (name[i] == '/' || (name[i] as int) < 32) { return false; } i++; }
    return true;
}

fn fs_set_attr(n: int, mask: int, on: bool) {
    if (n <= 0) { return; }
    if (on) { fs_nodes[n].attr = fs_nodes[n].attr | mask; } else { fs_nodes[n].attr = fs_nodes[n].attr & ~mask; }
    fs_mark();
}

/// rename in place: 0 ok, 1 invalid name, 2 name exists, 3 read-only, 4 root
fn fs_rename(n: int, name: *u8) -> int {
    if (n <= 0) { return 4; }
    if (!fs_valid_name(name)) { return 1; }
    if ((fs_nodes[n].attr & FA_RO) != 0) { return 3; }
    let c = fs_child(fs_nodes[n].parent, name);
    if (c >= 0 && c != n) { return 2; }
    kstrncpy(&fs_nodes[n].name[0], name, FS_NAME);
    fs_mark();
    return 0;
}

/// move n into directory `dir`, keeping its name: 0 ok, 1 target is not a folder, 2 name exists there, 3 into itself, 4 read-only / root
fn fs_move(n: int, dir: int) -> int {
    if (n <= 0) { return 4; }
    if ((fs_nodes[n].attr & FA_RO) != 0) { return 4; }
    if (dir < 0 || fs_nodes[dir].kind != K_DIR) { return 1; }
    if (fs_is_ancestor(n, dir)) { return 3; }
    if (fs_nodes[n].parent == dir) { return 0; }
    if (fs_child(dir, &fs_nodes[n].name[0]) >= 0) { return 2; }
    fs_nodes[n].parent = dir;
    fs_mark();
    return 0;
}

/// a name based on `base` that is free in `dir`: "base", "base copy", "base copy 2", ...
fn fs_unique_name(dir: int, base: *u8, out: *u8) {
    kstrncpy(out, base, FS_NAME);
    if (fs_child(dir, out) < 0) { return; }
    var k = 1;
    while (k < 200) {
        var b: u8[32];
        kstrncpy(&b[0], base, 16);
        var o = kstrlen(&b[0]);
        let sfx = " copy";
        var j = 0;
        while (sfx[j] != 0) { b[o] = sfx[j]; o++; j++; }
        if (k > 1) { b[o] = ' '; o++; o = o + itoa(k, &b[o]); }
        b[o] = 0;
        if (fs_child(dir, &b[0]) < 0) { kstrncpy(out, &b[0], FS_NAME); return; }
        k++;
    }
}

/// bytes in a node (file size, or the total of a folder's files); `items` counts nodes below
fn fs_tree_size(n: int, items: *int) -> int {
    if (fs_nodes[n].kind == K_FILE) { return fs_nodes[n].size; }
    var total = 0;
    var i = 1;
    while (i < FS_MAX) {
        if (fs_nodes[i].kind != K_FREE && fs_nodes[i].parent == n && i != n) {
            if (items != (0 as *int)) { items[0]++; }
            total = total + fs_tree_size(i, items);
        }
        i++;
    }
    return total;
}

/// copy node src (recursively) into directory dstdir under `name`; returns the new node or -1 (full, clash, into itself)
fn fs_copy(src: int, dstdir: int, name: *u8, depth: int) -> int {
    if (depth > 14 || src < 0 || dstdir < 0 || fs_nodes[dstdir].kind != K_DIR) { return -1; }
    if (fs_nodes[src].kind == K_DIR && fs_is_ancestor(src, dstdir)) { return -1; }
    if (!fs_valid_name(name) || fs_child(dstdir, name) >= 0) { return -1; }
    let n = fs_alloc_node();
    if (n < 0) { return -1; }
    kstrncpy(&fs_nodes[n].name[0], name, FS_NAME);
    fs_nodes[n].kind = fs_nodes[src].kind;
    fs_nodes[n].parent = dstdir;
    fs_nodes[n].size = 0; fs_nodes[n].cap = 0; fs_nodes[n].data = 0 as *u8;
    let now = fs_now();
    fs_nodes[n].mtime = now; fs_nodes[n].ctime = now;
    fs_nodes[n].attr = fs_nodes[src].attr & ~FA_RO;
    fs_mark();
    if (fs_nodes[src].kind == K_FILE) {
        if (fs_nodes[src].size > 0 && !fs_write(n, fs_nodes[src].data, fs_nodes[src].size, false)) { fs_nodes[n].kind = K_FREE; return -1; }
        return n;
    }
    var i = 1;
    while (i < FS_MAX) {
        if (fs_nodes[i].kind != K_FREE && fs_nodes[i].parent == src && i != n && i != src) {
            if (fs_copy(i, n, &fs_nodes[i].name[0], depth + 1) < 0) { fs_remove_tree2(n); return -1; }
        }
        i++;
    }
    return n;
}

fn fs_lower(c: int) -> int { if (c >= 'A' && c <= 'Z') { return c + 32; } return c; }
/// case-insensitive name order
fn fs_name_cmp(a: int, b: int) -> int {
    let x = &fs_nodes[a].name[0]; let y = &fs_nodes[b].name[0];
    var i = 0;
    while (x[i] != 0 && y[i] != 0) {
        let cx = fs_lower(x[i] as int); let cy = fs_lower(y[i] as int);
        if (cx != cy) { return cx - cy; }
        i++;
    }
    return (x[i] as int) - (y[i] as int);
}

/// children of `dir` into out[] (at most max): folders first, then by name; hidden ones only with show_hidden. Returns the count.
fn fs_list(dir: int, out: *int, max: int, show_hidden: bool) -> int {
    var n = 0;
    var i = 1;
    while (i < FS_MAX && n < max) {
        if (fs_nodes[i].kind != K_FREE && fs_nodes[i].parent == dir && i != dir) {
            if (show_hidden || (fs_nodes[i].attr & FA_HIDDEN) == 0) {
                // insertion sort
                var k = n;
                while (k > 0) {
                    let o = out[k - 1];
                    let before = (fs_nodes[i].kind == K_DIR && fs_nodes[o].kind != K_DIR) ||
                                 (fs_nodes[i].kind == fs_nodes[o].kind && fs_name_cmp(i, o) < 0);
                    if (!before) { break; }
                    out[k] = o; k--;
                }
                out[k] = i; n++;
            }
        }
        i++;
    }
    return n;
}

fn fs_child_count(dir: int) -> int {
    var c = 0; var i = 1;
    while (i < FS_MAX) { if (fs_nodes[i].kind != K_FREE && fs_nodes[i].parent == dir && i != dir) { c++; } i++; }
    return c;
}

/// consistency check; with repair=true problems are fixed. out[0] problems, out[1] orphans/bad parents, out[2] duplicate names,
/// out[3] bad sizes, out[4] bad nodes/names. Orphans go to /lost+found.
fn fs_fsck(repair: bool, out: *int) -> int {
    out[0] = 0; out[1] = 0; out[2] = 0; out[3] = 0; out[4] = 0;
    if (fs_nodes[0].kind != K_DIR) { out[0]++; out[4]++; if (repair) { fs_nodes[0].kind = K_DIR; } }
    var lf = -1;
    var i = 1;
    while (i < FS_MAX) {
        let k = fs_nodes[i].kind;
        if (k != K_FREE) {
            if (k != K_FILE && k != K_DIR) {
                out[0]++; out[4]++;
                if (repair) { fs_nodes[i].kind = K_FREE; }
            } else {
                if (fs_nodes[i].name[0] == 0) {
                    out[0]++; out[4]++;
                    if (repair) { kstrncpy(&fs_nodes[i].name[0], "unnamed", FS_NAME); }
                }
                if (k == K_FILE) {
                    let sz = fs_nodes[i].size;
                    if (sz < 0 || sz > fs_nodes[i].cap || (sz > 0 && fs_nodes[i].data == (0 as *u8))) {
                        out[0]++; out[3]++;
                        if (repair) { fs_nodes[i].size = 0; }
                    }
                }
                // parent chain must end at the root through live folders
                var c = i; var depth = 0; var ok = true;
                while (c != 0 && depth < 80) {
                    let p = fs_nodes[c].parent;
                    if (p < 0 || p >= FS_MAX || fs_nodes[p].kind != K_DIR || p == c) { ok = false; break; }
                    c = p; depth++;
                }
                if (c != 0) { ok = false; }
                if (!ok) {
                    out[0]++; out[1]++;
                    if (repair) {
                        if (lf < 0) { lf = fs_child(0, "lost+found"); if (lf < 0) { lf = fs_create("/lost+found", K_DIR); } }
                        if (lf >= 0 && lf != i) {
                            var nm: u8[32];
                            fs_unique_name(lf, &fs_nodes[i].name[0], &nm[0]);
                            kstrncpy(&fs_nodes[i].name[0], &nm[0], FS_NAME);
                            fs_nodes[i].parent = lf;
                        }
                    }
                }
            }
        }
        i++;
    }
    // duplicate names inside one folder
    i = 1;
    while (i < FS_MAX) {
        if (fs_nodes[i].kind != K_FREE) {
            var j = i + 1;
            while (j < FS_MAX) {
                if (fs_nodes[j].kind != K_FREE && fs_nodes[j].parent == fs_nodes[i].parent && kstreq(&fs_nodes[j].name[0], &fs_nodes[i].name[0])) {
                    out[0]++; out[2]++;
                    if (repair) {
                        var nm: u8[32];
                        fs_unique_name(fs_nodes[j].parent, &fs_nodes[j].name[0], &nm[0]);
                        kstrncpy(&fs_nodes[j].name[0], &nm[0], FS_NAME);
                    }
                }
                j++;
            }
        }
        i++;
    }
    if (repair && out[0] > 0) { fs_mark(); }
    return out[0];
}
