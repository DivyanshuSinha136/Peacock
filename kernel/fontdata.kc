const VF_N = 5;
fn vf_name(i: int) -> *u8 {
    if (i == 0) { return "Inter"; }
    if (i == 1) { return "Poppins"; }
    if (i == 2) { return "DejaVu Sans"; }
    if (i == 3) { return "Liberation Serif"; }
    if (i == 4) { return "DejaVu Mono"; }
    return "";
}
/// pixel size at which the font is drawn in the UI (equal visual size across faces)
fn vf_px(i: int) -> int {
    if (i == 0) { return 14; }
    if (i == 1) { return 13; }
    if (i == 2) { return 13; }
    if (i == 3) { return 15; }
    if (i == 4) { return 13; }
    return 14;
}
