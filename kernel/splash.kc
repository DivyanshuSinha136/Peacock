// splash.kc -- boot splash: the Peacock logo (a 160x280 picture read from the disk image, see tools/mklogo.py) on white, a rotating
// dot ring, a progress bar and a status line, animated from the 100 Hz timer while the kernel initialises.
// Author: Divyanshu Sinha (MIT License)
const SPL_MIN_TICKS = 160;                 // the splash stays at least 1.6 s so the animation is seen even on a fast boot
const SPL_LW = 160;                        // logo size in pixels
const SPL_LH = 280;
const SPL_LSECT = 350;                     // SPL_LW * SPL_LH * 4 / 512

var spl_pct = 0;                           // progress target 0..100
var spl_shown = 0;                         // progress currently drawn (eases towards the target)
var spl_msg: u8[48];
var spl_last = -1;
var spl_t0 = 0;
var spl_dx: int[12] = [0, 500, 866, 1000, 866, 500, 0, -500, -866, -1000, -866, -500];
var spl_dy: int[12] = [-1000, -866, -500, 0, 500, 866, 1000, 866, 500, 0, -500, -866];

/// top of the splash block (logo + ring + bar + text, 386 px high), kept on screen for 640x480
fn spl_top() -> int { return imax(8, (fb_h - 386) / 2); }

fn spl_bg() {
    clip_x0 = 0; clip_y0 = 0; clip_x1 = fb_w; clip_y1 = fb_h;
    fill(0, 0, fb_w, fb_h, 0xFFFFFF);
    let cx = fb_w / 2;
    let top = spl_top();
    var drawn = false;
    if (disk_present) {
        let buf = kmalloc(SPL_LSECT * 512);
        if (buf != (0 as *u8)) {
            if (ata_read(logo_lba(), SPL_LSECT, buf)) {
                let px = buf as *u32;
                var y = 0;
                while (y < SPL_LH) {
                    var x = 0;
                    let row = (top + y) * fb_w + (cx - SPL_LW / 2);
                    while (x < SPL_LW) { bb[row + x] = p64(px[y * SPL_LW + x] as int) as u64; x++; }
                    y++;
                }
                drawn = true;
            }
            kfree(buf);
        }
    }
    if (!drawn) {                                              // no logo on the disk: a text title instead
        let t1: *u8 = "PEACOCK";
        draw_text_sc(cx - (kstrlen(t1) * 8 * 5) / 2, top + 100, t1, 0x2A5CA8, 5);
    }
    let vs = os_version();
    draw_text(cx - (kstrlen(vs) * 8) / 2, fb_h - 26, vs, 0x9A94B0);
    flush_rect(0, 0, fb_w, fb_h);
}

fn spl_draw() {
    clip_x0 = 0; clip_y0 = 0; clip_x1 = fb_w; clip_y1 = fb_h;
    let cx = fb_w / 2;
    let top = spl_top();
    let cy = top + SPL_LH + 36;
    let head = (ticks / 6) % 12;                                 // the bright dot advances every 60 ms
    fill(cx - 200, cy - 24, 400, 100, 0xFFFFFF);
    var i = 0;
    while (i < 12) {
        let age = (head - i + 12) % 12;                           // 0 = head, grows along the tail
        let px = cx + (spl_dx[i] * 17) / 1000;
        let py = cy + (spl_dy[i] * 17) / 1000;
        rfill(px - 3, py - 3, 6, 6, 3, 0xEDE8F6, false);          // pale base dot
        var col = 0x2A7BD0;
        if (age == 0) { col = 0xC2418F; }
        shade(px - 3, py - 3, 6, 6, col, 255 - age * 21);
        i++;
    }
    let bw = 240; let bh = 6;
    let bx = cx - bw / 2; let by = cy + 34;
    rfill(bx, by, bw, bh, 3, 0xEDE8F6, false);
    if (spl_shown > 0) { rfill(bx, by, (bw * spl_shown) / 100 + 6, bh, 3, 0x2A7BD0, false); }
    let w = kstrlen(&spl_msg[0]) * 8;
    draw_text(cx - w / 2, by + 14, &spl_msg[0], 0x5A5470);
    flush_rect(cx - 200, cy - 24, 400, 100);
}

/// advance the animation if the timer moved on
fn spl_pump() {
    if (ticks == spl_last) { return; }
    spl_last = ticks;
    if (spl_shown < spl_pct) { spl_shown++; }
    spl_draw();
}

fn splash_begin() {
    spl_pct = 0; spl_shown = 0; spl_last = -1; spl_t0 = ticks;
    kstrncpy(&spl_msg[0], "Starting...", 47);
    spl_bg();
    spl_draw();
}

/// a stage of start-up begins: set the progress target and the text, and let the bar catch up with the animation running
fn splash(pct: int, msg: *u8) {
    spl_pct = pct;
    kstrncpy(&spl_msg[0], msg, 47);
    var n = 0;
    while (spl_shown < spl_pct && n < 4000000) { spl_pump(); hlt(); n++; }
    spl_pump();
}

fn splash_end() {
    splash(100, "Welcome");
    while (ticks < spl_t0 + SPL_MIN_TICKS) { spl_pump(); hlt(); }
}
