// samples.kc -- example apps written with the App Builder, seeded into /apps on first boot.  (generated by tools/gensamples.py)

/// the sample apps; each set is added once (the version in /etc/apps-seed says how far this machine got), so deleted samples stay deleted
fn bld_put(name: *u8, src: *u8) {
    var p: u8[64]; kstrncpy(&p[0], "/apps/", 64); kstrncpy(&p[6], name, 40); kstrncpy(&p[kstrlen(&p[0])], ".pea", 5);
    if (fs_resolve(&p[0]) < 0) {
        let nd = fs_create(&p[0], K_FILE);
        if (nd >= 0) { pea_compile(src, kstrlen(src), nd); }              // samples ship as sources and are installed as binaries
    }
}
fn bld_seed_apps() {
    var ver = 0;
    let vn = fs_resolve("/etc/apps-seed");
    if (vn >= 0 && fs_nodes[vn].size > 0) { ver = (fs_nodes[vn].data[0] as int) - 48; }
    if (fs_resolve("/apps") >= 0 && vn < 0) { ver = 1; }               // machines from before 1.2 already have the first set
    if (ver >= 3) { return; }
    fs_create("/apps", K_DIR);
    if (ver < 1) {
        bld_put("counter", "APP|counter|260|170|15527924\nW|1|20|14|220|20|1778739|0|-1|0|Click the buttons:|\nW|5|20|44|220|56|16777215|0|-1|0||\nW|1|30|56|200|32|2060267|0|-1|2|0|\nW|2|20|114|70|32|2600544|2|2|0|+1|1\nW|2|100|114|70|32|15158332|2|2|0|-1|-1\nW|2|180|114|60|32|15965202|1|2|0|Reset|0\n");
        bld_put("adder", "APP|adder|300|170|14477050\nW|1|20|14|260|20|1778739|0|-1|0|Add two numbers (Enter works too)|\nW|3|20|44|100|28|1778739|12|5|0|12|1+3\nW|1|128|50|16|20|1778739|0|-1|0|+|\nW|3|150|44|100|28|1778739|12|5|0|30|1+3\nW|2|20|90|60|32|2060267|12|5|0|=|1+3\nW|1|96|90|190|32|9323693|0|-1|2|...|\n");
        bld_put("greeter", "APP|greeter|300|190|14477050\nW|1|20|14|260|20|1778739|0|-1|0|What is your name?|\nW|3|20|40|180|28|1778739|4|3|0||1\nW|2|210|40|70|28|2060267|4|3|0|Greet|1\nW|1|20|92|260|24|9323693|0|-1|0|...|\nW|4|20|134|200|22|2060267|6|3|0|Hide the greeting|\n");
        bld_put("keypad", "APP|keypad|220|252|15527924\nW|5|16|12|188|48|16777215|0|-1|0||\nW|1|24|20|176|32|2060267|0|-1|2||\nW|2|16|70|56|36|14477050|11|1|0|1|1\nW|2|80|70|56|36|14477050|11|1|0|2|2\nW|2|144|70|56|36|14477050|11|1|0|3|3\nW|2|16|114|56|36|14477050|11|1|0|4|4\nW|2|80|114|56|36|14477050|11|1|0|5|5\nW|2|144|114|56|36|14477050|11|1|0|6|6\nW|2|16|158|56|36|14477050|11|1|0|7|7\nW|2|80|158|56|36|14477050|11|1|0|8|8\nW|2|144|158|56|36|14477050|11|1|0|9|9\nW|2|16|202|120|36|14477050|11|1|0|0|0\nW|2|144|202|56|36|15158332|5|1|0|C|\n");
        bld_put("progress", "APP|progress|280|150|15527924\nW|1|20|14|240|20|1778739|0|-1|0|Progress bar demo|\nW|6|20|46|240|18|2600544|0|-1|0|30|\nW|2|20|84|100|32|2600544|2|1|0|+10|10\nW|2|140|84|100|32|15158332|2|1|0|-10|-10\n");
        bld_put("launcher", "APP|launcher|260|200|15527924\nW|1|20|14|220|20|1778739|0|-1|0|Quick launcher|\nW|2|20|44|100|32|2060267|8|-1|0|Notes|notes\nW|2|130|44|100|32|2600544|8|-1|0|Paint|paint\nW|2|20|86|100|32|15965202|8|-1|0|Calc|calc\nW|2|130|86|100|32|9323693|8|-1|0|Terminal|terminal\nW|2|20|138|210|32|15158332|10|-1|0|Close launcher|\n");
    }
    if (ver < 2) {
    bld_put("stopwatch", "APP|Stopwatch|260|170|15527924\nW|1|20|12|220|32|1778739|0|-1|2|Stopwatch||0|-1|0|\nW|1|20|56|120|32|2060267|0|-1|2|0||0|-1|0|\nW|9|150|60|96|24|1778739|2|1|1||1|0|-1|1|\nW|2|20|108|100|32|2600544|6|2|0|Start / Stop||0|-1|0|\nW|2|136|108|100|32|15158332|1|1|0|Reset|0|0|-1|0|\n");
        bld_put("countdown", "APP|Countdown|260|170|15527924\nW|1|20|12|220|32|1778739|0|-1|2|Countdown||0|-1|0|\nW|1|20|56|120|32|15158332|0|-1|2|10||0|-1|0|\nW|9|150|60|96|24|1778739|16|1|1||0|2|1|1|-1\nW|2|20|108|100|32|2600544|6|2|0|Start / Stop||0|-1|0|\nW|2|136|108|100|32|15965202|1|1|0|Reset 10|10|0|-1|0|\n");
        bld_put("dice", "APP|Dice|260|190|15527924\nW|1|20|12|220|20|1778739|0|-1|0|Roll the dice||0|-1|0|\nW|5|20|44|100|70|16777215|0|-1|0|||0|-1|0|\nW|1|20|60|100|40|15158332|0|-1|2|?||0|-1|0|\nW|2|140|44|100|32|2060267|17|2|0|Roll d6|6|0|-1|0|\nW|2|140|84|100|32|9323693|17|2|0|Roll d20|20|0|-1|0|\nW|8|20|130|32|32|15965202|17|2|0||6|0|-1|20|\n");
        bld_put("tipcalc", "APP|Tip calculator|300|230|15527924\nW|1|20|14|260|20|1778739|0|-1|0|Tip calculator||0|-1|0|\nW|1|20|50|80|20|1778739|0|-1|0|Bill:||0|-1|0|\nW|3|110|44|120|28|1778739|12|7|0|80|2*4|12|7|0|7/5\nW|1|20|92|80|20|1778739|0|-1|0|Tip %:||0|-1|0|\nW|7|110|88|170|22|2060267|12|7|0|15|2*4|12|7|0|7/5\nW|1|0|0|40|16|1778739|0|-1|1|100||0|-1|0|\nW|1|20|140|80|20|1778739|0|-1|0|Tip:||0|-1|0|\nW|1|110|132|150|32|2600544|0|-1|2|12||0|-1|0|\nW|2|20|182|260|32|2060267|12|7|0|Calculate|2*4|12|7|0|7/5\n");
    }
    if (ver < 4) { bld_put("spinner3d", "APP|3D Spinner|380|300|15527924\nW|1|20|12|340|24|1778739|0|-1|0|Drag the shape to turn it||0|-1|0|\nW|10|20|44|210|220|5209343|0|-1|0|||0|-1|133|\nW|2|256|60|100|30|2060267|7|1|0|Red|4|0|-1|0|\nW|2|256|100|100|30|2060267|7|1|0|Green|7|0|-1|0|\nW|2|256|140|100|30|2060267|7|1|0|Blue|8|0|-1|0|\nW|2|256|180|100|30|2060267|7|1|0|Purple|9|0|-1|0|\n"); }
    pea_migrate();                                                    // programs saved by older builders become binaries
    fs_put_file("/etc/apps-seed", "4");
}
