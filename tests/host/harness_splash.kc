import "../../kernel/splash.kc";

fn hlt() { ticks = ticks + 1; }          // the host "timer" advances one tick per hlt

fn main() -> int {
    let fbmem = malloc((800 * 600 * 4) as u64);
    gfx_init(800, 600, 3200, 32, fbmem as int);
    splash_begin();
    dump_ppm("splash0.ppm");
    splash(35, "Detecting disk");
    println("shown after stage 35:", spl_shown);
    dump_ppm("splash1.ppm");
    splash(70, "Installing apps");
    splash(92, "Preparing the desktop");
    let t = ticks;
    splash_end();
    println("shown at end:", spl_shown, "ticks spent:", ticks - spl_t0, "min:", SPL_MIN_TICKS);
    dump_ppm("splash2.ppm");
    if (spl_shown != 100 || ticks - spl_t0 < SPL_MIN_TICKS) { println("SPLASH FAIL"); return 1; }
    println("splash ok");
    return 0;
}
