// usb_host.kc -- a simulated UHCI controller with USB devices behind its two root ports (host tests only; replaces kernel/usbhw.kc).
// It walks the frame list / queue heads / transfer descriptors the driver builds in memory, exactly like the hardware would, and
// models a HID keyboard, a HID tablet and a bulk-only mass-storage device.  Inactive until a test calls ush_enable().

var ush_on = false;
var ush_cmd = 0; var ush_frnum = 0; var ush_frbase = 0; var ush_sts = 0;
var ush_pst: int[2];                 // port status bits (connect, change, enable, reset)
var ush_type: int[2];                // 0 none, 1 keyboard, 2 tablet, 3 storage, 4 relative mouse
var ush_addr: int[2]; var ush_pend: int[2];
var ush_resp: u8[600]; var ush_rlen: int[2]; var ush_roff: int[2];
var ush_wlen: int[2];
var ush_rq: u8[16];
var ush_sbuf: u8[2100]; var ush_sl: int[2]; var ush_so: int[2];   // storage: pending data-in bytes
var ush_stage: int[2];               // storage: 0 idle, 1 data-in pending, 2 csw pending
var ush_tag: int[2];
var ush_rep: u8[256]; var ush_rh: int[2]; var ush_rt: int[2];   // 2 ports x 16 reports x 8 bytes
var ush_nsetup = 0; var ush_nbulk = 0; var ush_nreads = 0; var ush_idle_seen = 0; var ush_proto_seen = 0;
var ush_dev_idx = -1;

fn ush_enable() { ush_on = true; }
fn ush_attach(p: int, t: int) { ush_type[p] = t; ush_pst[p] = 1 | 2; ush_addr[p] = 0; ush_rh[p] = 0; ush_rt[p] = 0; ush_stage[p] = 0; }
fn ush_detach(p: int) { ush_type[p] = 0; ush_pst[p] = 2; ush_addr[p] = 0; }
fn ush_report(p: int, a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) {
    let o = p * 128 + ush_rt[p] * 8;
    ush_rep[o] = a as u8; ush_rep[o + 1] = b as u8; ush_rep[o + 2] = c as u8; ush_rep[o + 3] = d as u8;
    ush_rep[o + 4] = e as u8; ush_rep[o + 5] = f as u8; ush_rep[o + 6] = g as u8; ush_rep[o + 7] = h as u8;
    ush_rt[p] = (ush_rt[p] + 1) % 16;
}

fn ush_va(pa: int) -> int { return pa + usb_dma_off; }
fn ush_r32(a: int) -> int { return *(a as *u32) as int; }
fn ush_w32(a: int, v: int) { *(a as *u32) = v as u32; }

fn uh_find() -> bool {
    if (!ush_on) { return false; }
    let probe = malloc(16);
    usb_dma_off = (probe as int) & ~0xFFFFFFFF;
    usb_io = 0x1000;
    ush_cmd = 0; ush_sts = 0x20;
    return true;
}

fn ush_put(p: int, s: *u8, n: int) { kmemcpy(&ush_resp[0], s, n); ush_rlen[p] = n; ush_roff[p] = 0; }

fn ush_devdesc(p: int) {
    var d: u8[18];
    kmemset(&d[0], 0, 18);
    d[0] = 18; d[1] = 1; d[2] = 0x10; d[3] = 1; d[7] = 8;
    d[8] = 0x27; d[9] = 0x06; d[10] = (0x10 + ush_type[p]) as u8; d[11] = 0; d[17] = 1;
    ush_put(p, &d[0], 18);
}
fn ush_cfgdesc(p: int) {
    var c: u8[40];
    kmemset(&c[0], 0, 40);
    var n = 9;
    c[0] = 9; c[1] = 2; c[4] = 1; c[5] = 1; c[7] = 0x80; c[8] = 50;
    c[n] = 9; c[n + 1] = 4; c[n + 4] = 1;
    if (ush_type[p] == 3) {
        c[n + 4] = 2; c[n + 5] = 8; c[n + 6] = 6; c[n + 7] = 0x50;
        n = n + 9;
        c[n] = 7; c[n + 1] = 5; c[n + 2] = 0x81; c[n + 3] = 2; c[n + 4] = 64; n = n + 7;
        c[n] = 7; c[n + 1] = 5; c[n + 2] = 0x02; c[n + 3] = 2; c[n + 4] = 64; n = n + 7;
    } else {
        c[n + 5] = 3;
        if (ush_type[p] == 1) { c[n + 6] = 1; c[n + 7] = 1; }
        if (ush_type[p] == 4) { c[n + 6] = 1; c[n + 7] = 2; }
        n = n + 9;
        c[n] = 9; c[n + 1] = 0x21; c[n + 2] = 0x11; c[n + 3] = 1; c[n + 5] = 1; c[n + 6] = 0x22; c[n + 7] = 63; n = n + 9;     // HID descriptor
        c[n] = 7; c[n + 1] = 5; c[n + 2] = 0x81; c[n + 3] = 3; c[n + 4] = 8; c[n + 6] = 10; n = n + 7;
    }
    c[2] = n as u8;
    ush_put(p, &c[0], n);
}

fn ush_setup(p: int, s: *u8) {
    ush_nsetup++;
    var i = 0;
    while (i < 8) { ush_rq[i] = s[i]; i++; }
    let rt = s[0] as int; let rq = s[1] as int; let v = (s[2] as int) | ((s[3] as int) << 8);
    ush_wlen[p] = (s[6] as int) | ((s[7] as int) << 8);
    ush_rlen[p] = 0; ush_roff[p] = 0;
    if (rt == 0x80 && rq == 6) {
        if ((v >> 8) == 1) { ush_devdesc(p); }
        else if ((v >> 8) == 2) { ush_cfgdesc(p); }
    } else if (rt == 0 && rq == 5) { ush_pend[p] = v; }
    else if (rt == 0x21 && rq == 0x0B) { ush_proto_seen++; }
    else if (rt == 0x21 && rq == 0x0A) { ush_idle_seen++; }
}

/// 1 = done, 0 = NAK, -1 = stall
fn ush_xfer(p: int, pid: int, ep: int, buf: int, maxlen: int, actlen: *int) -> int {
    actlen[0] = 0;
    if (ep == 0) {
        if (pid == 0x2D) { ush_setup(p, buf as *u8); return 1; }
        if (pid == 0x69) {                                                         // IN: data stage or the status stage of an OUT request
            if (maxlen == 0) {
                if (ush_pend[p] != 0 && ush_rq[1] == 5) { ush_addr[p] = ush_pend[p]; ush_pend[p] = 0; }
                return 1;
            }
            var n = ush_rlen[p]; if (n > ush_wlen[p]) { n = ush_wlen[p]; }
            n = n - ush_roff[p];
            if (n > maxlen) { n = maxlen; }
            if (n < 0) { n = 0; }
            kmemcpy(buf as *u8, &ush_resp[ush_roff[p]], n);
            ush_roff[p] = ush_roff[p] + n; actlen[0] = n;
            return 1;
        }
        if (pid == 0xE1) {                                                         // OUT: status stage of an IN request
            if (ush_pend[p] != 0 && ush_rq[1] == 5) { ush_addr[p] = ush_pend[p]; ush_pend[p] = 0; }
            return 1;
        }
        return -1;
    }
    if (ush_type[p] == 3) {                                                        // mass storage, bulk-only
        ush_nbulk++;
        let b = buf as *u8;
        if (pid == 0xE1 && ep == 2) {                                              // CBW
            if (ush_r32(buf) != 0x43425355) { return -1; }
            ush_tag[p] = ush_r32(buf + 4);
            let op = b[15] as int;
            ush_sl[p] = 0; ush_so[p] = 0; ush_stage[p] = 2;
            if (op == 0x12) {
                kmemset(&ush_sbuf[0], 0, 36);
                kmemcpy(&ush_sbuf[8], "PEACOCK SIM DISK        1.0 ", 28);
                ush_sl[p] = 36; ush_stage[p] = 1;
            } else if (op == 0x25) {
                kmemset(&ush_sbuf[0], 0, 8);
                ush_sbuf[3] = 127; ush_sbuf[6] = 2;                                // 128 blocks of 512 bytes
                ush_sl[p] = 8; ush_stage[p] = 1;
            } else if (op == 0x28) {
                let lba = ((b[17] as int) << 24) | ((b[18] as int) << 16) | ((b[19] as int) << 8) | (b[20] as int);
                let cnt = ((b[22] as int) << 8) | (b[23] as int);
                var j = 0;
                while (j < cnt * 512) { ush_sbuf[j] = ((lba + j / 512) * 7 + j) as u8; j++; }
                ush_sl[p] = cnt * 512; ush_stage[p] = 1; ush_nreads++;
            }
            return 1;
        }
        if (pid == 0x69 && ep == 1) {
            if (ush_stage[p] == 1) {
                var n = ush_sl[p] - ush_so[p];
                if (n > maxlen) { n = maxlen; }
                kmemcpy(b, &ush_sbuf[ush_so[p]], n);
                ush_so[p] = ush_so[p] + n; actlen[0] = n;
                if (ush_so[p] >= ush_sl[p]) { ush_stage[p] = 2; }
                return 1;
            }
            if (ush_stage[p] == 2) {
                ush_w32(buf, 0x53425355); ush_w32(buf + 4, ush_tag[p]); ush_w32(buf + 8, 0); b[12] = 0;
                actlen[0] = 13; ush_stage[p] = 0;
                return 1;
            }
            return 0;
        }
        return -1;
    }
    if (pid == 0x69 && ep == 1) {                                                  // HID interrupt IN
        if (ush_rh[p] == ush_rt[p]) { return 0; }
        let o = p * 128 + ush_rh[p] * 8;
        var n = 8; if (n > maxlen) { n = maxlen; }
        kmemcpy(buf as *u8, &ush_rep[o], n);
        ush_rh[p] = (ush_rh[p] + 1) % 16; actlen[0] = n;
        return 1;
    }
    return -1;
}

fn ush_find_dev(a: int) -> int {
    var p = 0;
    while (p < 2) {
        if (ush_type[p] != 0 && (ush_pst[p] & 4) != 0 && ush_addr[p] == a) { return p; }
        p++;
    }
    return -1;
}

/// process one TD; true = it completed (so a depth-first chain may continue)
fn ush_td(t: int) -> bool {
    let st = ush_r32(t + 4);
    if ((st & 0x800000) == 0) { return true; }
    let tk = ush_r32(t + 8);
    let pid = tk & 255; let a = (tk >> 8) & 127; let ep = (tk >> 15) & 15;
    var ml = (tk >> 21) & 0x7FF; if (ml == 0x7FF) { ml = 0; } else { ml = ml + 1; }
    let p = ush_find_dev(a);
    if (p < 0) { ush_w32(t + 4, (st & ~0x800000) | 0x40000); return false; }        // no answer: timeout error
    var act: int[1];
    let r = ush_xfer(p, pid, ep, ush_va(ush_r32(t + 12)), ml, &act[0]);
    if (r == 0) { ush_w32(t + 4, st | 0x80000); return false; }                    // NAK: stays active
    if (r < 0) { ush_w32(t + 4, (st & ~0x800000) | 0x400000); return false; }       // STALL
    var al = 0x7FF;
    if (act[0] > 0) { al = act[0] - 1; }
    ush_w32(t + 4, (st & ~0x80000 & ~0x800000 & ~0x7FF) | al);
    return true;
}

fn ush_run() {
    if ((ush_cmd & 1) == 0) { return; }
    var e = ush_r32(ush_va(ush_frbase));
    var guard = 0;
    while ((e & 1) == 0 && guard < 16) {
        let q = ush_va(e & ~15);
        var el = ush_r32(q + 4);
        var tg = 0;
        while ((el & 1) == 0 && tg < 128) {
            let t = ush_va(el & ~15);
            if (!ush_td(t)) { break; }
            let lk = ush_r32(t);
            el = lk;
            ush_w32(q + 4, lk);
            if ((lk & 4) == 0 && (lk & 1) == 0) { break; }
            tg++;
        }
        e = ush_r32(q);
        guard++;
    }
}

fn uh_r16(o: int) -> int {
    if (o == 0x02) { ush_run(); return ush_sts; }
    if (o == 0x06) { ush_frnum = (ush_frnum + 1) & 0x7FF; return ush_frnum; }
    if (o == 0x00) { return ush_cmd; }
    if (o >= 0x10 && o < 0x14) {
        let p = (o - 0x10) / 2;
        return ush_pst[p] | 0x80;
    }
    return 0;
}
fn uh_w16(o: int, v: int) {
    if (o == 0x00) { ush_cmd = v & ~2; if ((v & 1) == 0) { ush_sts = 0x20; } else { ush_sts = 0; } return; }
    if (o == 0x02) { return; }
    if (o >= 0x10 && o < 0x14) {
        let p = (o - 0x10) / 2;
        var s = ush_pst[p];
        if ((s & 0x200) != 0 && (v & 0x200) == 0) {                                // reset released: the device falls back to address 0
            ush_addr[p] = 0; ush_pend[p] = 0;
        }
        s = (s & ~0x200) | (v & 0x200);
        if ((v & 2) != 0) { s = s & ~2; }
        if ((v & 8) != 0) { s = s & ~8; }
        if ((v & 4) != 0 && ush_type[p] != 0 && (s & 0x200) == 0) { s = s | 4; } else { s = s & ~4; }
        ush_pst[p] = s;
        return;
    }
}
fn uh_r32(o: int) -> int { return ush_frbase; }
fn uh_w32(o: int, v: int) { if (o == 0x08) { ush_frbase = v; } }
